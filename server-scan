#!/bin/bash
# ==============================================================================
# 脚本名称: server-scan
# 功能说明: server-scan 统一入口，调度各专项诊断脚本
# 适用系统: Linux (CentOS/Ubuntu/Debian/RHEL) / macOS (Intel/Apple Silicon)
# 使用方法: ./server-scan <子命令> [选项]
# ==============================================================================

set -euo pipefail

# 获取脚本目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 加载共享库（含 i18n）
source "$SCRIPT_DIR/lib/common.sh"

# 版本信息
VERSION="1.0.0"

# ==============================================================================
# 帮助信息
# ==============================================================================
print_help() {
    cat <<EOF
$(ss::msg MSG_HELP_USAGE): server-scan <$(ss::msg MSG_HELP_OPTIONS)> $(ss::msg MSG_HELP_EXAMPLES)

$(ss::msg MSG_SCAN_DESC)

$(ss::msg MSG_HELP_USAGE):
  overview        $(ss::msg MSG_SCAN_SUBCMD_OVERVIEW)
  cpu-mem         $(ss::msg MSG_SCAN_SUBCMD_CPUMEM)
  disk            $(ss::msg MSG_SCAN_SUBCMD_DISK)
  network         $(ss::msg MSG_SCAN_SUBCMD_NETWORK)
  security        $(ss::msg MSG_SCAN_SUBCMD_SECURITY)
  all             $(ss::msg MSG_SCAN_SUBCMD_ALL)

$(ss::msg MSG_HELP_COMMON_OPTIONS):
  -o, --output PATH     $(ss::msg MSG_HELP_OUTPUT)
  -c, --config FILE     $(ss::msg MSG_HELP_CONFIG)
  -q, --quiet           $(ss::msg MSG_HELP_QUIET)
      --json            $(ss::msg MSG_HELP_JSON)
      --no-color        $(ss::msg MSG_HELP_NO_COLOR)
      --lang LANG       $(ss::msg MSG_HELP_LANG)
      --notify          $(ss::msg MSG_HELP_NOTIFY)
      --notify-test     $(ss::msg MSG_HELP_NOTIFY_TEST)
  -h, --help            $(ss::msg MSG_HELP_HELP)
  -v, --version         $(ss::msg MSG_HELP_VERSION)

$(ss::msg MSG_HELP_EXAMPLES):
  # $(ss::msg MSG_SCAN_EXAMPLE_OVERVIEW)
  server-scan overview

  # $(ss::msg MSG_SCAN_EXAMPLE_DISK_CUSTOM)
  server-scan disk -o /tmp/disk_report.md

  # $(ss::msg MSG_SCAN_EXAMPLE_DISK_DIR)
  server-scan disk -d /var/log -d /home/user --depth 5

  # $(ss::msg MSG_SCAN_EXAMPLE_QUIET)
  server-scan overview --quiet

  # $(ss::msg MSG_SCAN_EXAMPLE_JSON)
  server-scan overview --json

  # $(ss::msg MSG_SCAN_EXAMPLE_ALL)
  server-scan all

  # $(ss::msg MSG_SCAN_EXAMPLE_SECURITY)
  server-scan security

EOF
    exit 0
}

# ==============================================================================
# 版本信息
# ==============================================================================
print_version() {
    echo "server-scan version $VERSION"
    exit 0
}

# ==============================================================================
# 检查子命令是否存在
# ==============================================================================
check_script() {
    local script_name="$1"
    local script_path="$SCRIPT_DIR/$script_name"
    if [ ! -f "$script_path" ]; then
        echo "$(ss::msg MSG_ERROR_SCRIPT_NOT_FOUND) $script_path" >&2
        exit 1
    fi
    if [ ! -x "$script_path" ]; then
        chmod +x "$script_path"
    fi
}

# ==============================================================================
# 主入口
# ==============================================================================
if [ $# -eq 0 ]; then
    print_help
fi

SUBCOMMAND="$1"
shift

# 处理顶层选项
case "$SUBCOMMAND" in
-h | --help)
    print_help
    ;;
-v | --version)
    print_version
    ;;
esac

# 执行子命令
case "$SUBCOMMAND" in
overview)
    check_script "sys_overview.sh"
    exec "$SCRIPT_DIR/sys_overview.sh" "$@"
    ;;
cpu-mem)
    check_script "cpu_mem_analyzer.sh"
    exec "$SCRIPT_DIR/cpu_mem_analyzer.sh" "$@"
    ;;
disk)
    check_script "disk_analyzer.sh"
    exec "$SCRIPT_DIR/disk_analyzer.sh" "$@"
    ;;
network)
    check_script "network_analyzer.sh"
    exec "$SCRIPT_DIR/network_analyzer.sh" "$@"
    ;;
security)
    check_script "security_scanner.sh"
    exec "$SCRIPT_DIR/security_scanner.sh" "$@"
    ;;
all)
    echo "$(ss::msg MSG_SCAN_ALL_START)"
    echo ""

    # 传递公共选项给每个脚本（处理空参数情况）
    if [ $# -gt 0 ]; then
        SCRIPT_ARGS=("$@")
    else
        SCRIPT_ARGS=()
    fi

    echo "=========================================="
    echo "$(ss::msg MSG_SCAN_STEP_1)"
    echo "=========================================="
    if [ ${#SCRIPT_ARGS[@]} -gt 0 ]; then
        "$SCRIPT_DIR/sys_overview.sh" "${SCRIPT_ARGS[@]}" || true
    else
        "$SCRIPT_DIR/sys_overview.sh" || true
    fi
    echo ""

    echo "=========================================="
    echo "$(ss::msg MSG_SCAN_STEP_2)"
    echo "=========================================="
    if [ ${#SCRIPT_ARGS[@]} -gt 0 ]; then
        "$SCRIPT_DIR/cpu_mem_analyzer.sh" "${SCRIPT_ARGS[@]}" || true
    else
        "$SCRIPT_DIR/cpu_mem_analyzer.sh" || true
    fi
    echo ""

    echo "=========================================="
    echo "$(ss::msg MSG_SCAN_STEP_3)"
    echo "=========================================="
    if [ ${#SCRIPT_ARGS[@]} -gt 0 ]; then
        "$SCRIPT_DIR/disk_analyzer.sh" "${SCRIPT_ARGS[@]}" || true
    else
        "$SCRIPT_DIR/disk_analyzer.sh" || true
    fi
    echo ""

    echo "=========================================="
    echo "$(ss::msg MSG_SCAN_STEP_4)"
    echo "=========================================="
    if [ ${#SCRIPT_ARGS[@]} -gt 0 ]; then
        "$SCRIPT_DIR/network_analyzer.sh" "${SCRIPT_ARGS[@]}" || true
    else
        "$SCRIPT_DIR/network_analyzer.sh" || true
    fi
    echo ""

    echo "=========================================="
    echo "$(ss::msg MSG_SCAN_STEP_5)"
    echo "=========================================="
    if [ ${#SCRIPT_ARGS[@]} -gt 0 ]; then
        "$SCRIPT_DIR/security_scanner.sh" "${SCRIPT_ARGS[@]}" || true
    else
        "$SCRIPT_DIR/security_scanner.sh" || true
    fi
    echo ""

    echo "$(ss::msg MSG_SCAN_ALL_DONE)"
    ;;
*)
    echo "$(ss::msg MSG_ERROR_UNKNOWN_CMD) '$SUBCOMMAND'" >&2
    echo "" >&2
    print_help
    ;;
esac
