#!/bin/bash
# ==============================================================================
# 脚本名称: server-scan
# 功能说明: server-scan 统一入口，调度各专项诊断脚本
# 适用系统: Linux (CentOS/Ubuntu/Debian/RHEL) / macOS (Intel/Apple Silicon)
# 使用方法: ./server-scan <子命令> [选项]
# ==============================================================================

set -euo pipefail

# 获取脚本目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 版本信息
VERSION="1.0.0"

# ==============================================================================
# 帮助信息
# ==============================================================================
print_help() {
	cat <<EOF
用法: server-scan <子命令> [选项]

服务器性能诊断工具集，提供一站式系统瓶颈分析。

子命令:
  overview        系统瓶颈总览（CPU / 内存 / 磁盘 / 网络快速扫描）
  cpu-mem         CPU 与内存专项深度分析
  disk            磁盘专项深度分析（空间 / I/O / inode / 大文件 / Docker）
  network         网络专项排查（接口 / 连通性 / 连接数 / DNS）
  all             依次执行所有诊断脚本

公共选项:
  -o, --output PATH     报告输出路径（覆盖默认路径）
  -c, --config FILE     指定配置文件（覆盖默认配置文件查找）
  -q, --quiet           静默模式（只输出报告路径一行，供 Agent 解析）
      --json            在 stdout 输出一行 JSON 元数据（供 Agent 程序化消费）
      --no-color        禁用 ANSI 颜色（Agent 调用时必需）
  -h, --help            显示此帮助信息
  -v, --version         显示版本信息

示例:
  # 运行系统瓶颈总览
  server-scan overview

  # 磁盘专项分析，自定义输出路径
  server-scan disk -o /tmp/disk_report.md

  # 指定目录扫描
  server-scan disk -d /var/log -d /home/user --depth 5

  # 静默模式（供 Agent 使用）
  server-scan overview --quiet

  # JSON 输出（供 Agent 程序化消费）
  server-scan overview --json

  # 运行所有诊断
  server-scan all

EOF
	exit 0
}

# ==============================================================================
# 版本信息
# ==============================================================================
print_version() {
	echo "server-scan version $VERSION"
	exit 0
}

# ==============================================================================
# 检查子命令是否存在
# ==============================================================================
check_script() {
	local script_name="$1"
	local script_path="$SCRIPT_DIR/$script_name"
	if [ ! -f "$script_path" ]; then
		echo "错误: 找不到脚本 $script_path" >&2
		exit 1
	fi
	if [ ! -x "$script_path" ]; then
		chmod +x "$script_path"
	fi
}

# ==============================================================================
# 主入口
# ==============================================================================
if [ $# -eq 0 ]; then
	print_help
fi

SUBCOMMAND="$1"
shift

# 处理顶层选项
case "$SUBCOMMAND" in
-h | --help)
	print_help
	;;
-v | --version)
	print_version
	;;
esac

# 执行子命令
case "$SUBCOMMAND" in
overview)
	check_script "sys_overview.sh"
	exec "$SCRIPT_DIR/sys_overview.sh" "$@"
	;;
cpu-mem)
	check_script "cpu_mem_analyzer.sh"
	exec "$SCRIPT_DIR/cpu_mem_analyzer.sh" "$@"
	;;
disk)
	check_script "disk_analyzer.sh"
	exec "$SCRIPT_DIR/disk_analyzer.sh" "$@"
	;;
network)
	check_script "network_analyzer.sh"
	exec "$SCRIPT_DIR/network_analyzer.sh" "$@"
	;;
all)
	echo "🚀 开始执行所有诊断脚本..."
	echo ""

	# 传递公共选项给每个脚本（处理空参数情况）
	if [ $# -gt 0 ]; then
		SCRIPT_ARGS=("$@")
	else
		SCRIPT_ARGS=()
	fi

	echo "=========================================="
	echo "1/4. 系统瓶颈总览"
	echo "=========================================="
	if [ ${#SCRIPT_ARGS[@]} -gt 0 ]; then
		"$SCRIPT_DIR/sys_overview.sh" "${SCRIPT_ARGS[@]}" || true
	else
		"$SCRIPT_DIR/sys_overview.sh" || true
	fi
	echo ""

	echo "=========================================="
	echo "2/4. CPU 与内存专项分析"
	echo "=========================================="
	if [ ${#SCRIPT_ARGS[@]} -gt 0 ]; then
		"$SCRIPT_DIR/cpu_mem_analyzer.sh" "${SCRIPT_ARGS[@]}" || true
	else
		"$SCRIPT_DIR/cpu_mem_analyzer.sh" || true
	fi
	echo ""

	echo "=========================================="
	echo "3/4. 磁盘专项分析"
	echo "=========================================="
	if [ ${#SCRIPT_ARGS[@]} -gt 0 ]; then
		"$SCRIPT_DIR/disk_analyzer.sh" "${SCRIPT_ARGS[@]}" || true
	else
		"$SCRIPT_DIR/disk_analyzer.sh" || true
	fi
	echo ""

	echo "=========================================="
	echo "4/4. 网络专项排查"
	echo "=========================================="
	if [ ${#SCRIPT_ARGS[@]} -gt 0 ]; then
		"$SCRIPT_DIR/network_analyzer.sh" "${SCRIPT_ARGS[@]}" || true
	else
		"$SCRIPT_DIR/network_analyzer.sh" || true
	fi
	echo ""

	echo "✅ 所有诊断完成！"
	;;
*)
	echo "错误: 未知子命令 '$SUBCOMMAND'" >&2
	echo "" >&2
	print_help
	;;
esac
