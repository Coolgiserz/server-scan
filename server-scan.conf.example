# ==============================================================================
# server-scan 统一配置文件
# ==============================================================================
# 所有扫描脚本共用这一份配置文件，按「变量名前缀」各取所需，互不干扰：
#   disk_analyzer.sh     取 DISK_ INODE_ IO_ LARGE_FILE_ LOG_ DOCKER_ MOUNT_
#                          SCAN_ ENABLE_ REALTIME_ MACOS_ REPORT_ TEMP_
#   cpu_mem_analyzer.sh  取 CPU_MEM_ SAMPLE_ ENABLE_ SWAP_ ZOMBIE_ D_STATE_
#
# 书写约定（重要）:
#   1. 注释必须独占一行，放在变量上方；不要写成 KEY=value # 注释
#      这样才能彻底避免「值里含 # 时被误判为注释」的歧义
#   2. 值若含空格或特殊字符（含 #），请用引号包裹: KEY="a #b"
#   3. 未加引号的值中，连续空白之后的 # 仍会被当作注释（与 shell 行为一致）
#
# 通知配置请见 notify.conf.example：
#   webhook 与签名密钥属于敏感信息，独立成文件以便单独设置 chmod 600，
#   不与普通配置项混在一起。
#
# 配置文件路径（优先级从高到低）:
#   1. 命令行 -c/--config 指定
#   2. 环境变量 CONFIG_FILE
#   3. $SCRIPT_DIR/server-scan.conf          （推荐，复制本文件后修改）
#   4. $SCRIPT_DIR/disk_analyzer.conf        （旧版兼容，新文件不存在时生效）
#
# 使用示例:
#   cp server-scan.conf.example server-scan.conf
#   ./server-scan disk                       # 使用统一配置
#   ./server-scan cpu-mem                    # 同一份配置同样生效
#   ./server-scan disk -c my.conf            # 临时指定其他配置
#
# 配置变更时无需手工复制，执行 ./server-scan config upgrade 自动补齐新增项
# ==============================================================================

# 报告输出路径（留空用默认产物目录）
REPORT_PATH=""

# ==============================================================================
# 一、磁盘专项（disk_analyzer.sh）
# ==============================================================================

# 磁盘使用率警告阈值（%）
DISK_USAGE_WARNING_THRESHOLD=80

# 磁盘使用率危险阈值（%）
DISK_USAGE_CRITICAL_THRESHOLD=90

# inode 使用率警告阈值（%）
INODE_USAGE_WARNING_THRESHOLD=70

# inode 使用率危险阈值（%）
INODE_USAGE_CRITICAL_THRESHOLD=90

# I/O await 优秀阈值（ms）
IO_AWAIT_EXCELLENT_THRESHOLD=10

# I/O await 正常阈值（ms）
IO_AWAIT_GOOD_THRESHOLD=20

# I/O await 缓慢阈值（ms）
IO_AWAIT_SLOW_THRESHOLD=50

# I/O %util 健康阈值（%）
IO_UTIL_HEALTHY_THRESHOLD=60

# I/O %util 繁忙阈值（%）
IO_UTIL_BUSY_THRESHOLD=80

# 大文件扫描深度
LARGE_FILE_SCAN_DEPTH=6

# 大文件大小阈值
LARGE_FILE_SIZE_THRESHOLD="1G"

# 大文件扫描超时时间（秒）
LARGE_FILE_SCAN_TIMEOUT=30

# 大文件 Top N
LARGE_FILE_TOP=20

# 日志扫描目录
LOG_SCAN_DIR="/var/log"

# 日志文件大小阈值
LOG_FILE_SIZE_THRESHOLD="100M"

# Docker 数据目录。当 docker 的 data-root 被改为非默认路径
# （如 /data/docker，常见于数据盘独立挂载）时必须指定，否则会误扫
# /var/lib/docker（该目录迁移后常作为残留空目录保留，导致统计大小失真）。
# 也可用命令行 --docker-dir 指定，命令行优先级高于此处配置
DOCKER_DATA_DIR=""

# 容器日志目录，默认取 <DOCKER_DATA_DIR>/containers，
# 仅当日志目录与数据目录分离时才需要单独指定（命令行 --docker-log-dir）
DOCKER_LOG_DIR=""

# docker info 探测超时（秒）
DOCKER_INFO_TIMEOUT=10

# Docker 镜像 Top N
DOCKER_IMAGE_TOP=15

# Docker 容器 Top N
DOCKER_CONTAINER_TOP=10

# Docker 卷 Top N
DOCKER_VOLUME_TOP=15

# Docker 日志文件大小阈值
DOCKER_LOG_SIZE_THRESHOLD="100M"

# Docker 构建缓存 Top N
DOCKER_BUILD_CACHE_TOP=15

# 运行中容器日志大小 Top N
DOCKER_CONTAINER_LOG_TOP=10

# 挂载点扫描深度
MOUNT_SCAN_DEPTH=1

# 挂载点扫描 Top N
MOUNT_SCAN_TOP=10

# 挂载点扫描超时时间（秒）
MOUNT_SCAN_TIMEOUT=20

# 指定目录扫描深度（-d/--dir 模式）
SCAN_DEPTH=3

# 指定目录扫描 Top N
SCAN_TOP=20

# 是否启用实时 I/O 负载快照
ENABLE_REALTIME_IO="false"

# 实时 I/O 采样间隔（秒）
REALTIME_IO_INTERVAL=2

# macOS I/O tps 阈值
MACOS_IO_TPS_THRESHOLD=1000

# macOS I/O MB/s 阈值
MACOS_IO_MBS_THRESHOLD=100

# 报告建议中的磁盘使用率警告阈值（%）
REPORT_DISK_USAGE_WARNING=85

# 报告建议中的 inode 使用率警告阈值（%）
REPORT_INODE_USAGE_WARNING=80

# 报告建议中的 I/O await 警告阈值（ms）
REPORT_IO_AWAIT_WARNING=20

# 报告建议中的 I/O %util 警告阈值（%）
REPORT_IO_UTIL_WARNING=100

# 临时目录列表（空格分隔）
TEMP_SCAN_DIRS="/tmp /var/tmp"

# 大临时文件阈值
TEMP_FILE_SIZE_THRESHOLD="100M"

# 临时目录扫描深度
TEMP_SCAN_DEPTH=3

# 临时文件 Top N
TEMP_TOP=20

# 单个目录扫描超时时间（秒）
TEMP_SCAN_TIMEOUT=20

# 旧文件判定阈值（未访问天数）
TEMP_OLD_DAYS=7

# 缓存目录按系统自动确定，无需配置
#   Linux: /var/cache 与 ~/.cache
#   macOS: ~/Library/Caches

# ==============================================================================
# 二、CPU 与内存专项（cpu_mem_analyzer.sh）
# ==============================================================================

# 是否启用多核采样（仅 Linux 有效）
ENABLE_MPSTAT="true"

# 采样间隔（秒）
SAMPLE_INTERVAL=1

# 采样次数
SAMPLE_COUNT=3

# Swap 使用率告警阈值（%）
# 说明: 该指标「存在即告警」会产生常态噪声（macOS/Linux 常有少量 swap 占用），
# 因此一律按阈值判定
SWAP_USAGE_WARNING_THRESHOLD=50

# 僵尸进程 critical 阈值（个）；低于此值仅提示
ZOMBIE_CRITICAL_THRESHOLD=50

# D 状态进程告警阈值（个）；瞬时 IO 等待属常态
D_STATE_WARNING_THRESHOLD=5
