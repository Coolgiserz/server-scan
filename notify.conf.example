# ==============================================================================
# server-scan 通知推送配置文件
# ==============================================================================
# 用途: 将扫描结果推送到外部 Channel（当前支持飞书自定义机器人）
#
# 使用方法:
#   1. 复制此文件: cp notify.conf.example notify.conf
#   2. 填写 NOTIFY_WEBHOOK（必填）
#   3. 按需调整其他参数
#   4. 运行扫描时加 --notify 参数（或将 NOTIFY_ENABLED 设为 true 以默认开启）
#
# 配置文件查找顺序（找到第一个存在的文件即停止）:
#   1. $NOTIFY_CONFIG              环境变量指定
#   2. $SCRIPT_DIR/notify.conf     项目根目录
#   3. $HOME/.server-scan/notify.conf
#   4. /etc/server-scan/notify.conf
#
# 优先级（高 -> 低）: 命令行参数 > 环境变量 > 配置文件
#
# 安全提示:
#   - 本文件可能包含 webhook 与签名密钥，请设置权限 chmod 600
#   - 不要将填写后的 notify.conf 提交到代码仓库
# ==============================================================================

# ------------------------------------------------------------------------------
# 基础开关
# ------------------------------------------------------------------------------
# 是否启用通知推送。设为 true 后所有扫描脚本默认推送；
# 保持 false 时，可用命令行 --notify 按需单次启用（推荐）
NOTIFY_ENABLED=false

# 通知渠道。当前支持: feishu（飞书自定义机器人）
NOTIFY_CHANNEL=feishu

# Webhook 地址（必填）
# 飞书: 群设置 -> 群机器人 -> 添加机器人 -> 自定义机器人 -> 复制 Webhook 地址
NOTIFY_WEBHOOK=

# 签名密钥（可选）
# 若飞书机器人安全设置中启用了「签名校验」，请填写此处对应的密钥
# 留空表示机器人未开启签名校验
NOTIFY_SECRET=

# ------------------------------------------------------------------------------
# 内容与格式
# ------------------------------------------------------------------------------
# 消息类型:
#   text - 纯文本消息（兼容性最好，默认）
#   card - 交互式卡片消息（更美观，标题颜色随告警级别变化）
NOTIFY_MSG_TYPE=text

# 内容模式:
#   summary - 只推送头部信息 + 告警项摘要（推荐，消息精炼）
#   full    - 推送完整报告正文（超过 NOTIFY_MAX_BYTES 会自动截断）
NOTIFY_MODE=summary

# 全文模式下的正文最大字节数（默认 20000）
# 飞书自定义机器人消息体上限约为 30KB，此处留有余量
NOTIFY_MAX_BYTES=20000

# 摘要模式下最多提取多少行告警项
NOTIFY_SUMMARY_LINES=20

# ------------------------------------------------------------------------------
# 推送策略
# ------------------------------------------------------------------------------
# HTTP 请求超时时间（秒）
NOTIFY_TIMEOUT=10

# 仅在检测到告警时推送（报告中含 🔴 或 🟡 标记）
# 适合用于定时巡检，避免正常状态下刷屏
NOTIFY_ON_ALERT_ONLY=false

# ------------------------------------------------------------------------------
# @提及（飞书）
# ------------------------------------------------------------------------------
# 是否 @所有人。注意: 需机器人在群内具备相应权限
NOTIFY_MENTION_ALL=false

# @指定用户，多个用逗号分隔（飞书 open_id，形如 ou_xxxxxxxx）
# 示例: NOTIFY_MENTION_IDS=ou_abc123,ou_def456
NOTIFY_MENTION_IDS=

# ------------------------------------------------------------------------------
# 使用示例
# ------------------------------------------------------------------------------
# 1) 按需单次推送:
#      ./server-scan overview --notify
#
# 2) 指定渠道与 webhook（临时调试，webhook 会出现在进程列表中）:
#      ./server-scan disk --notify --webhook "https://open.feishu.cn/open-apis/bot/v2/hook/xxx"
#
# 3) 仅告警时推送（适合 crontab 定时巡检）:
#      NOTIFY_ON_ALERT_ONLY=true ./server-scan cpu-mem --notify
#
# 4) 测试配置是否正确:
#      ./server-scan overview --notify-test
#
# 5) 使用非默认路径的配置文件:
#      NOTIFY_CONFIG=/etc/server-scan/notify.conf ./server-scan network --notify
# ==============================================================================
